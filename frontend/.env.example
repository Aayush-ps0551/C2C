# ==========================================
# GD Arena Frontend Environment Variables
# ==========================================

# Supabase Configuration (Client-side anon/public key only)
# Get credentials from https://supabase.com -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Origin
# In local development: leave empty to use Vite proxy (/api -> localhost:5000)
# In Vercel production: set to your deployed Render backend URL (e.g., https://gd-arena-backend.onrender.com)
VITE_API_URL=

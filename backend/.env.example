# ==========================================
# GD Arena Backend Environment Variables
# ==========================================

# Server Port (Render sets process.env.PORT automatically)
PORT=5000

# OpenRouter Configuration (Pure OpenRouter AI Gateway)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Primary Model (Default: liquid/lfm-2.5-2.6b:free)
OPENROUTER_PRIMARY_MODEL=liquid/lfm-2.5-2.6b:free

# OpenRouter Fallback Model (Default: nvidia/nemotron-3.5-lightning:free)
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free

# Supabase Configuration (PostgreSQL Database)
# Credentials from Supabase Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

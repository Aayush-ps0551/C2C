# ==========================================
# GD Arena Environment Variables
# ==========================================

# OpenRouter Configuration (Pure OpenRouter AI Gateway)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Primary Model (High-speed, top reasoning)
OPENROUTER_PRIMARY_MODEL=apodex/apodex-1.1-mini:free

# OpenRouter Fallback Model (Automatic fallback if primary is busy or rate-limited)
OPENROUTER_FALLBACK_MODEL=liquid/lfm-2.5-2.6b:free

# Supabase Configuration
# Create a free project at https://supabase.com and copy credentials from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

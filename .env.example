# ==========================================
# GD Arena Environment Variables
# ==========================================

# OpenRouter Configuration (Primary LLM Gateway)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Primary Model (High-speed, top reasoning)
# Examples: google/gemini-2.0-flash-001, anthropic/claude-3.5-haiku, meta-llama/llama-3.3-70b-instruct
OPENROUTER_PRIMARY_MODEL=google/gemini-2.0-flash-001

# OpenRouter Fallback Model (Automatic fallback if primary is busy or fails)
# Examples: meta-llama/llama-3.3-70b-instruct, deepseek/deepseek-chat, mistralai/mistral-small-24b-instruct-2501
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct

# Secondary AI Provider (Optional Gemini Direct Fallback)
# Get key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Supabase Configuration
# Create a free project at https://supabase.com and copy credentials from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Note: If Supabase credentials are not provided, GD Arena automatically operates in seamless local storage mode without crashing!

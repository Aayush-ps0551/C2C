# ==========================================
# GD Arena Environment Variables Template
# ==========================================

# ------------------------------------------
# Backend Variables (Render / Server)
# ------------------------------------------

# Port assigned automatically on Render; defaults to 5000 locally
PORT=5000

# OpenRouter Configuration (Server-Side LLM Gateway)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Models
OPENROUTER_PRIMARY_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free

# Supabase Server-Side Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------
# Frontend Variables (Vercel / Client)
# ------------------------------------------

# Supabase Client-Side Public Credentials
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Render Backend URL for Production (Leave blank in local development for Vite proxy)
# Example: https://gd-arena-backend.onrender.com
VITE_API_URL=
